{
    "name":  "jornadaviva-web",
    "private":  true,
    "version":  "1.0.0",
    "type":  "module",
    "dependencies":  {
                         "@fontsource-variable/inter":  "^5.3.0",
                         "clsx":  "^2.1.1",
                         "dayjs":  "^1.11.23",
                         "firebase":  "^13.2.0",
                         "jsqr":  "^1.4.0",
                         "lucide-react":  "^1.70.0",
                         "qrcode.react":  "^4.2.0",
                         "react":  "^19.3.1",
                         "react-dom":  "^19.3.1",
                         "react-router":  "^8.5.1"
                     },
    "devDependencies":  {
                            "@tailwindcss/vite":  "^4.3.5",
                            "@types/node":  "^26.6.6",
                            "@types/react":  "^19.3.0",
                            "@types/react-dom":  "^19.3.0",
                            "@vitejs/plugin-react":  "^6.2.1",
                            "tailwindcss":  "^4.3.5",
                            "typescript":  "^7.0.2",
                            "vite":  "^8.3.6"
                        },
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc --noEmit \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "typecheck":  "tsc --noEmit",
                    "dev:emulador":  "vite --mode emulador",
                    "emulador:firebase":  "npx --yes firebase-tools emulators:start --only firestore,auth --project demo-jornadaviva --config emulador/firebase.json",
                    "emulador:semilla":  "node emulador/seed.mjs",
                    "emulador:api":  "node emulador/api.mjs"
                },
    "description":  "Versión web de Jornada Viva. Comparte backend (API + Firebase) y lógica de negocio con la app móvil (../Jornada-Viva)."
}
