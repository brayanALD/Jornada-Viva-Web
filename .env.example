# Copia este archivo a .env (cp .env.example .env).
# La web usa el MISMO backend que la app móvil: la misma API y el mismo proyecto de Firebase.

# Proyecto de Firebase (la misma configuración pública que firebaseConfig.js de la app móvil)
VITE_FIREBASE_API_KEY=AIzaSyBo9lXsJmeTs1ZcdPpLpggp6x94orqXvJw
VITE_FIREBASE_AUTH_DOMAIN=jornadaviva-476ff.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jornadaviva-476ff
VITE_FIREBASE_STORAGE_BUCKET=jornadaviva-476ff.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=257986670996
VITE_FIREBASE_APP_ID=1:257986670996:web:6a1d7751bac0246dac1f81

# URL de la API. Vacía = el mismo origen de la web: en desarrollo la reenvía el servidor de Vite
# (vite.config.ts) y en producción un rewrite del hosting (vercel.json). Así no hace falta CORS.
# Si prefieres llamar a la API directamente, escribe su URL y añade el origen de la web a CORS_ORIGINS del servidor.
VITE_API_URL=

# API real a la que reenvía el servidor de desarrollo
JV_API_TARGET=https://jornada-viva.onrender.com

# (Opcional) Ruta del proyecto móvil cuyo código de dominio se reutiliza, relativa a esta carpeta.
# Por defecto se usa el submódulo `mobile/` (git submodule update --init); si no existe, ../Jornada-Viva.
# JV_MOBILE_PATH=../Jornada-Viva
