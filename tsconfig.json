{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@mobile/*": ["./mobile/*", "../Jornada-Viva/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
