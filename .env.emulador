# Modo `npm run dev:emulador`: la web usa los emuladores locales de Firebase y una API local
# (nunca toca los datos reales). Ver el README, sección «Probar sin tocar producción».
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-jornadaviva
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
JV_API_TARGET=http://127.0.0.1:8787
